{
  "name": "moneta-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev -w @moneta/web",
    "mobile": "npm run start -w @moneta/mobile",
    "check": "npm run check --workspaces --if-present && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
